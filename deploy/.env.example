# Image tag to run: "latest" (main branch) or a release tag like "v0.1.0"
APP_TAG=latest
# Local port nginx proxies to (bound to 127.0.0.1 only)
APP_PORT=8090
TZ=Europe/Berlin
# Where the database and uploads live on the host: a folder INSIDE the
# encrypted (gocryptfs) mount, not the mount point itself. Must exist.
PB_DATA_DIR=/mnt/secure/shopapp/pb_data

# User the container runs as; must be able to write PB_DATA_DIR.
# gocryptfs mounted by root: keep 10001 and chown the folder to 10001.
# gocryptfs mounted by your own user: set both to your ids (`id -u`, `id -g`).
PB_UID=10001
PB_GID=10001

# Optional. Encrypts only the stored settings (SMTP password, S3 backup keys),
# useful once S3 backups are configured. Generate once with
#   openssl rand -hex 16
# keep a copy in your password manager, never change it. Empty = off.
PB_ENCRYPTION_KEY=
